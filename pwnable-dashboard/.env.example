# CODEX_USER_PROMPT_FILE=
# CODEX_USER_PROMPT=
CODEX_PROMPT_MAX_BYTES=262144
PWN_AUTOMATOR_TRACE_ENABLED=true
PWN_AUTOMATOR_CHALLENGE_DIR=mcps/test
UPLOAD_LIMIT_BYTES=209715200
