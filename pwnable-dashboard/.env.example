HOST=0.0.0.0
PORT=3000
CODEX_AGENT_AUTORUN=true
CODEX_AGENT_COMMAND=codex
CODEX_AGENT_MODEL=gpt-5.3-codex
CODEX_MCP_AUTOCONFIG=true
CODEX_MCP_PROFILE=pwnautomator
CODEX_MCP_SERVER_NAME=pwnautomator
