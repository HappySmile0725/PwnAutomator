<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PwnAutomator - AI</title>
    <link rel="stylesheet" href="/dashboard/ai.css">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <%
        const pipelineData = pipeline || ai || {};
        const steps = Array.isArray(pipelineData.steps) ? pipelineData.steps : [];
        const files = Array.isArray(pipelineData.files) ? pipelineData.files : [];
        const output = Array.isArray(pipelineData.output) ? pipelineData.output : [];
        const statusText = String(pipelineData.status || 'idle').replace(/_/g, ' ');
        const runId = pipelineData.runId || '-';
        const contextDir = pipelineData.challenge?.contextDir || '-';
        const containerName = pipelineData.docker?.containerName || '-';
        const promptPath = pipelineData.codex?.promptPath || '-';
        const datasetPath = pipelineData.dataset?.packagePath || pipelineData.dataset?.filePath || '-';
    %>
    <div class="bg-grid"></div>
    <div class="dashboard">
        <header class="header">
            <div class="logo">
                <span class="logo-text">Pwn<span class="accent">Automator</span></span>
            </div>
            <nav class="header-toggle" aria-label="Dashboard navigation">
                <a href="/dashboard" class="toggle-link">Dashboard</a>
                <a href="/dashboard/ai" class="toggle-link active">AI</a>
                <span class="toggle-knob"></span>
            </nav>
        </header>

        <main class="main-content">
            <section class="panel flow-panel">
                <div class="panel-header">
                    <div>
                        <p class="eyebrow">Pipeline</p>
                        <h1 class="panel-title">Challenge to Dataset</h1>
                    </div>
                    <span class="status-pill" id="pipeline-status"><%= statusText %></span>
                </div>

                <ol class="stage-list" id="stage-list">
                    <% steps.forEach((step) => { %>
                        <li class="stage-item <%= step.status %>" data-stage="<%= step.key %>">
                            <span class="stage-index"><%= Number(step.index) + 1 %></span>
                            <div class="stage-body">
                                <span class="stage-name"><%= step.label %></span>
                                <span class="stage-detail"><%= step.detail || step.status %></span>
                            </div>
                            <span class="stage-status"><%= step.status %></span>
                        </li>
                    <% }) %>
                </ol>
            </section>

            <section class="panel control-panel">
                <div class="panel-header compact">
                    <div>
                        <p class="eyebrow">Control</p>
                        <h2 class="panel-title">Run Workspace</h2>
                    </div>
                </div>

                <form action="/dashboard/upload" method="POST" enctype="multipart/form-data" class="upload-form" id="upload-form">
                    <label class="upload-area" for="challenge-upload">
                        <input type="file" id="challenge-upload" name="challenge" multiple hidden>
                        <span class="upload-icon">UP</span>
                        <span class="upload-title">Upload challenge files or zip</span>
                        <span class="upload-subtitle" id="upload-file-name">Unified MCP/web challenge workspace</span>
                    </label>
                </form>

                <div class="button-row">
                    <button class="action-button primary" id="run-btn" type="button">
                        <span class="button-icon">RUN</span>
                        <span>Start Pipeline</span>
                    </button>
                    <button class="action-button danger" id="cancel-btn" type="button" disabled>
                        <span class="button-icon">STOP</span>
                        <span>Cancel LLM</span>
                    </button>
                    <button class="action-button" id="dataset-btn" type="button">
                        <span class="button-icon">DS</span>
                        <span>Save Dataset</span>
                    </button>
                </div>

                <dl class="meta-grid">
                    <div>
                        <dt>Run ID</dt>
                        <dd id="run-id"><%= runId %></dd>
                    </div>
                    <div>
                        <dt>Docker Context</dt>
                        <dd id="context-dir"><%= contextDir %></dd>
                    </div>
                    <div>
                        <dt>Container</dt>
                        <dd id="container-name"><%= containerName %></dd>
                    </div>
                    <div>
                        <dt>Codex Prompt</dt>
                        <dd id="prompt-path"><%= promptPath %></dd>
                    </div>
                    <div>
                        <dt>Dataset Package</dt>
                        <dd id="dataset-path"><%= datasetPath %></dd>
                    </div>
                </dl>

                <div class="tracking-section">
                    <h3 class="section-title">Tracking Files</h3>
                    <div class="file-list" id="file-list">
                        <% if (files.length > 0) { %>
                            <% files.forEach((file) => { %>
                                <div class="file-item"><%= file %></div>
                            <% }) %>
                        <% } else { %>
                            <p class="empty-text">No challenge file detected yet.</p>
                        <% } %>
                    </div>
                </div>
            </section>

            <section class="panel output-panel">
                <div class="panel-header compact">
                    <div>
                        <p class="eyebrow">Runtime</p>
                        <h2 class="panel-title">Output</h2>
                    </div>
                </div>
                <div class="output-console" id="output-console">
                    <% if (output.length > 0) { %>
                        <% output.forEach((line) => { %>
                            <div class="console-line"><%= line %></div>
                        <% }) %>
                    <% } else { %>
                        <div class="console-line dim">Waiting for challenge upload...</div>
                    <% } %>
                </div>
            </section>

        </main>
    </div>

    <script id="initial-pipeline" type="application/json"><%- JSON.stringify(pipelineData).replace(/</g, '\\u003c') %></script>
    <script>
        const uploadInput = document.getElementById('challenge-upload');
        const uploadForm = document.getElementById('upload-form');
        const uploadFileName = document.getElementById('upload-file-name');
        const runButton = document.getElementById('run-btn');
        const cancelButton = document.getElementById('cancel-btn');
        const datasetButton = document.getElementById('dataset-btn');
        const statusPill = document.getElementById('pipeline-status');
        const stageList = document.getElementById('stage-list');
        const fileList = document.getElementById('file-list');
        const outputConsole = document.getElementById('output-console');
        const metaEls = {
            runId: document.getElementById('run-id'),
            contextDir: document.getElementById('context-dir'),
            containerName: document.getElementById('container-name'),
            promptPath: document.getElementById('prompt-path'),
            datasetPath: document.getElementById('dataset-path')
        };

        let lastOutputKey = '';

        const formatStatus = (value) => String(value || 'idle').replace(/_/g, ' ');

        const setBusy = (button, busy) => {
            button.disabled = busy;
            button.classList.toggle('busy', busy);
        };

        const renderStages = (steps) => {
            stageList.innerHTML = '';
            if (!Array.isArray(steps) || steps.length === 0) {
                return;
            }
            steps.forEach((step) => {
                const item = document.createElement('li');
                item.className = `stage-item ${step.status || 'pending'}`;
                item.dataset.stage = step.key;

                const index = document.createElement('span');
                index.className = 'stage-index';
                index.textContent = Number(step.index) + 1;

                const body = document.createElement('div');
                body.className = 'stage-body';
                const name = document.createElement('span');
                name.className = 'stage-name';
                name.textContent = step.label;
                const detail = document.createElement('span');
                detail.className = 'stage-detail';
                detail.textContent = step.detail || step.status || 'pending';
                body.append(name, detail);

                const status = document.createElement('span');
                status.className = 'stage-status';
                status.textContent = step.status || 'pending';

                item.append(index, body, status);
                stageList.appendChild(item);
            });
        };

        const renderFiles = (files) => {
            fileList.innerHTML = '';
            if (!Array.isArray(files) || files.length === 0) {
                const empty = document.createElement('p');
                empty.className = 'empty-text';
                empty.textContent = 'No challenge file detected yet.';
                fileList.appendChild(empty);
                return;
            }
            files.forEach((file) => {
                const item = document.createElement('div');
                item.className = 'file-item';
                item.textContent = file;
                fileList.appendChild(item);
            });
        };

        const renderOutput = (lines) => {
            const outputKey = Array.isArray(lines) ? lines.join('\n') : '';
            if (outputKey === lastOutputKey) {
                return;
            }
            lastOutputKey = outputKey;
            outputConsole.innerHTML = '';
            if (!Array.isArray(lines) || lines.length === 0) {
                const empty = document.createElement('div');
                empty.className = 'console-line dim';
                empty.textContent = 'Waiting for challenge upload...';
                outputConsole.appendChild(empty);
                return;
            }
            lines.forEach((line) => {
                const item = document.createElement('div');
                item.className = 'console-line';
                item.textContent = String(line || '')
                    .replace(/\\r\\n/g, '\n')
                    .replace(/\\n/g, '\n')
                    .replace(/\r\n/g, '\n');
                outputConsole.appendChild(item);
            });
            outputConsole.scrollTop = outputConsole.scrollHeight;
        };

        const renderPipeline = (pipeline) => {
            const data = pipeline || {};
            statusPill.textContent = formatStatus(data.status);
            statusPill.dataset.status = data.status || 'idle';
            renderStages(data.steps);
            renderFiles(data.files);
            renderOutput(data.output);

            metaEls.runId.textContent = data.runId || '-';
            metaEls.contextDir.textContent = data.challenge?.contextDir || '-';
            metaEls.containerName.textContent = data.docker?.containerName || '-';
            metaEls.promptPath.textContent = data.codex?.promptPath || '-';
            metaEls.datasetPath.textContent = data.dataset?.packagePath || data.dataset?.filePath || '-';

            const running = data.status === 'running';
            const codexRunning = running && data.currentStage === 'codex_agent';
            setBusy(runButton, running);
            cancelButton.disabled = !codexRunning;
            datasetButton.disabled = running;
        };

        const requestPipeline = async (url, options = {}) => {
            const response = await fetch(url, {
                ...options,
                headers: {
                    'Accept': 'application/json',
                    ...(options.headers || {})
                }
            });
            const data = await response.json();
            if (data.pipeline) {
                renderPipeline(data.pipeline);
            }
            if (!response.ok) {
                throw new Error(data.error || 'Request failed.');
            }
            return data;
        };

        uploadInput.addEventListener('change', async function() {
            if (this.files.length === 0) {
                return;
            }
            uploadFileName.textContent = Array.from(this.files).map((file) => file.name).join(', ');
            const formData = new FormData(uploadForm);
            try {
                await requestPipeline(uploadForm.action, { method: 'POST', body: formData });
            } catch (error) {
                renderOutput([error.message]);
            }
        });

        runButton.addEventListener('click', async () => {
            setBusy(runButton, true);
            try {
                await requestPipeline('/dashboard/ai/run', { method: 'POST' });
            } catch (error) {
                renderOutput([error.message]);
                setBusy(runButton, false);
            }
        });

        cancelButton.addEventListener('click', async () => {
            setBusy(cancelButton, true);
            try {
                await requestPipeline('/dashboard/ai/cancel', { method: 'POST' });
            } catch (error) {
                renderOutput([error.message]);
            } finally {
                setBusy(cancelButton, false);
            }
        });

        datasetButton.addEventListener('click', async () => {
            setBusy(datasetButton, true);
            try {
                await requestPipeline('/dashboard/ai/dataset', { method: 'POST' });
            } catch (error) {
                renderOutput([error.message]);
            } finally {
                setBusy(datasetButton, false);
            }
        });

        const fetchStatus = () => {
            requestPipeline('/dashboard/ai/status').catch(() => {});
        };

        renderPipeline(JSON.parse(document.getElementById('initial-pipeline').textContent || '{}'));
        setInterval(fetchStatus, 1500);
    </script>
</body>
</html>
